# Copy to .env (docker compose reads it automatically). Never commit .env.
# Run `claude setup-token` on a machine where Claude Code is logged in and paste the result:
CLAUDE_CODE_OAUTH_TOKEN=
# JARVIS_MODEL=claude-opus-5
# JARVIS_EFFORT=medium
# JARVIS_ALLOW_WRITES=0

# Free Gemini key: voice in and out (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
